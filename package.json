    "audit:dependencies": "npm audit --omit=dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.25.6",
    "html-minifier-terser": "^7.2.0"
  }
}
