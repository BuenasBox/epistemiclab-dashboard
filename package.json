{
  "name": "epistemiclab-dashboard",
  "private": true,
  "scripts": {
    "build": "node tools/build-static.js",
    "state:update": "node tools/update-system-state.js",
    "state:check": "node tools/update-system-state.js --check",
    "test": "npm run state:update && node tools/run-tests.js",
